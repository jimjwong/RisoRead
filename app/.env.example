# Copy to .env.local and fill in.
#
# These must point at the SAME Supabase project RisoDesk uses. That is the whole
# design: one database, one set of accounts, one shelf. Pointing RisoRead at a
# project of its own gives you a second, empty application that happens to look
# the same.
#
# For local development both apps read the stack `npx supabase start` prints
# (run it from the RisoDesk repo root — RisoRead owns no migrations, because the
# tables it reads are RisoDesk's).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used in password-reset emails. Add this exact URL to the
# Supabase Auth redirect allow-list as well (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# https://console.anthropic.com
# Only used for suggesting tags on a book. Without it, uploads still work and
# tag suggestion is simply skipped.
ANTHROPIC_API_KEY=

# Cloudflare R2, where book files live. Optional: without these, files are read
# from and written to Supabase Storage instead, which the local stack already
# runs, and the whole feature works with no cloud account.
#
# Point these at the SAME bucket RisoDesk uses. Rows store an object path and
# never a URL, so a book uploaded by either application is readable by both.
#   R2_ACCOUNT_ID       Cloudflare dashboard, right-hand sidebar
#   R2_BUCKET           the bucket name
#   R2_ACCESS_KEY_ID    from an R2 API token with Object Read & Write
#   R2_SECRET_ACCESS_KEY
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
